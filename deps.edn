{:paths ["src" "resources"]

 :deps
 {org.clojure/clojure       {:mvn/version "1.12.0"}
  ring/ring-core             {:mvn/version "1.12.2"}
  ring/ring-jetty-adapter    {:mvn/version "1.12.2"}
  metosin/reitit             {:mvn/version "0.7.2"}
  metosin/malli              {:mvn/version "0.16.4"}
  com.github.seancorfield/next.jdbc   {:mvn/version "1.3.955"}
  com.github.seancorfield/honeysql    {:mvn/version "2.6.1243"}
  org.postgresql/postgresql   {:mvn/version "42.7.5"}
  com.zaxxer/HikariCP        {:mvn/version "6.2.1"}
  org.clojure/core.async      {:mvn/version "1.7.701"}
  org.clojure/data.csv         {:mvn/version "1.1.0"}
  org.clojure/data.json        {:mvn/version "2.5.1"}
  org.clojure/tools.logging    {:mvn/version "1.3.0"}
  ch.qos.logback/logback-classic {:mvn/version "1.5.16"}
  metosin/muuntaja             {:mvn/version "0.6.11"}
  buddy/buddy-sign             {:mvn/version "3.4.0"}
  metosin/ring-swagger-ui      {:mvn/version "5.9.0"}}

 :aliases
 {:build
  {:deps {org.clojure/tools.build {:mvn/version "0.9.2"}}
   :ns-default build}

  :test
  {:extra-paths ["test"]
   :extra-deps
   {lambdaisland/kaocha           {:mvn/version "1.91.1392"}
    lambdaisland/kaocha-cloverage  {:mvn/version "1.1.89"}
    clj-test-containers/clj-test-containers {:mvn/version "0.7.4"}
    ring/ring-mock                 {:mvn/version "0.4.0"}}
   :main-opts ["-m" "kaocha.runner"]}

  :lint
  {:deps {clj-kondo/clj-kondo {:mvn/version "2024.08.01"}}
   :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"]}

  :fmt
  {:deps {dev.weavejester/cljfmt {:mvn/version "0.13.0"}}
   :main-opts ["-m" "cljfmt.main" "check" "src" "test"]}}}
